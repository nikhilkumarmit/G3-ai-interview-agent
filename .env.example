# AI & Speech Service API Keys (Optional - Local mock/intelligent fallback active if absent)
GROQ_API_KEY=your_groq_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here


# Application Settings
PORT=8000
HOST=0.0.0.0
INTERVIEW_TIME_LIMIT_MINS=15
QUESTION_BUDGET=5
MAX_FOLLOWUPS_PER_QUESTION=2

# Voice Activity Detection (VAD) Settings
# stop_secs gives candidate a thinking pause cushion before concluding turn (STAR responses)
VAD_STOP_SECS=1.2
VAD_CONFIDENCE=0.5
VAD_MIN_VOLUME=0.6

# Storage
SESSION_STORAGE_DIR=sessions
REPORTS_STORAGE_DIR=reports
